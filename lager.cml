0010 PAGE
0020 // *** ELEKTRONIK LAGER SYSTEM ***
0030 PRINT "Indlaeser komponentdata..."
0040 DIM LAGER_NAVN$(1:4) OF 30, LAGER_ANTAL(1:4)
0050 ANTAL := 4
0060 I := 1
0070 WHILE I <= ANTAL DO
0080   READ LAGER_NAVN$(I), LAGER_ANTAL(I)
0090   I := I + 1
0100 ENDWHILE
0110 PRINT ""
0120 PRINT "LAGEROVERSIGT:"
0130 PRINT "------------------------"
0140 FOR J := 1 TO ANTAL DO
0150   PRINT LAGER_NAVN$(J), LAGER_ANTAL(J)
0160 ENDFOR J
0170 STOP
0180 DATA "Modstand 10k", 500, "Kondensator 100nF", 250
0190 DATA "BC547 Transistor", 100, "NE555 Timer", 50