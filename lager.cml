10 PAGE
20 // *** ELEKTRONIK LAGER SYSTEM ***
30 PRINT "Indlaeser komponentdata..."
40 ANTAL = 4
50 I = 1
60 WHILE I <= ANTAL DO
70   READ KOMP$, VAERDI
80   LAGER_NAVN$(I) = KOMP$
90   LAGER_ANTAL(I) = VAERDI
100  I = I + 1
110 ENDWHILE
120 PRINT ""
130 PRINT "LAGEROVERSIGT:"
140 PRINT "------------------------"
150 FOR J = 1 TO ANTAL DO
160   PRINT LAGER_NAVN$(J), LAGER_ANTAL(J)
170 ENDFOR
180 STOP
190 DATA "Modstand 10k", 500, "Kondensator 100nF", 250
200 DATA "BC547 Transistor", 100, "NE555 Timer", 50