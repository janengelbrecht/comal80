6230 PROC rekursiv_sum(fra%, til%, REF akk) CLOSED
6240   IF fra% > til% THEN RETURN
6250   akk := akk + fra%
6260   EXEC rekursiv_sum(fra% + 1, til%, akk)
6270 ENDPROC rekursiv_sum
