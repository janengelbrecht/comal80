10 PAGE
20 PRINT "==========================================="
30 PRINT "      COMAL-80 MASTER SYSTEM TEST"
40 PRINT "==========================================="
50 PRINT ""
60 
70 REM --- 1. VARIABLER, ARRAYS OG TILDELING ---
80 PRINT "1. TESTER VARIABLER OG ARRAYS..."
90 TEKST$ := "Dansk COMAL"
100 HELTAL% = 42
110 KOMMA = 3.1415
120 // Tester flerdimensionelle arrays og string-arrays
130 BORD$(1, 1) = "Konge"
140 BORD$(2, 2) := "Bonde"
150 MATRIX%(10) = 99
160 PRINT "   Basis: ", TEKST$, HELTAL%, KOMMA
170 PRINT "   Array: ", BORD$(1,1); " og "; BORD$(2,2), MATRIX%(10)
180 PRINT ""
190 
200 REM --- 2. MATEMATIK OG OPERATORER ---
210 PRINT "2. TESTER MATEMATIK OG LOGIK..."
220 PRINT "   Normal math (5+2*3) = ", 5 + 2 * 3
230 PRINT "   Potens      (2^8)   = ", 2 ^ 8
240 PRINT "   Modulo      (17 MOD 5) = ", 17 MOD 5
250 PRINT "   Heltalsdiv  (17 DIV 5) = ", 17 DIV 5
260 IF (10 > 5) AND (5 <> 4) THEN PRINT "   Logik (AND/<>) virker!"
270 IF NOT (1 = 0) OR (0 = 1) THEN PRINT "   Logik (NOT/OR) virker!"
280 PRINT ""
290 
300 REM --- 3. LOOPS OG KONTROLSTRUKTURER ---
310 PRINT "3. TESTER LOOPS..."
320 PRINT "   FOR-loop (baglaens): ";
330 FOR I% = 9 TO 3 STEP -3 DO
340   PRINT I%; " ";
350 ENDFOR
360 PRINT ""
370 
380 PRINT "   WHILE-loop: ";
390 W% = 0
400 WHILE W% < 2 DO
410   PRINT W%; " ";
420   W% = W% + 1
430 ENDWHILE
440 PRINT ""
450 
460 PRINT "   REPEAT-loop: ";
470 R% = 0
480 REPEAT
490   R% = R% + 1
500 UNTIL R% = 2
510 PRINT "Korte ", R%; " gange."
520 PRINT ""
530 
540 REM --- 4. DATA, READ OG RESTORE ---
550 PRINT "4. TESTER DATA OG LÆSNING..."
560 READ D1$, D2%
570 PRINT "   Forste laesning: ", D1$, D2%
580 RESTORE
590 READ