10 PAGE
20 REM *** MATEMATIK VÆRKTØJ ***
30 REPEAT
40   PRINT "1. Beregn Fakultet (!)"
50   PRINT "2. Afslut"
60   INPUT "Vaelg (1-2): ": VALG%
70   IF VALG% = 1 THEN BEREGN_FAKULTET()
80 UNTIL VALG% = 2
90 PRINT "Program afsluttet."
100 STOP
110 
120 PROC BEREGN_FAKULTET
130   INPUT "Indtast et heltal (1-10): ": TAL%
140   IF TAL% < 1 THEN TAL% = 1
150   IF TAL% > 10 THEN TAL% = 10
160   RESULTAT = 1
170   FOR K = 1 TO TAL% DO
180     RESULTAT = RESULTAT * K
190   ENDFOR
200   PRINT TAL%; "! = ", RESULTAT
210   PRINT ""
220 ENDPROC