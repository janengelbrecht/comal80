0010 PAGE
0020 REM *** MATEMATIK VÆRKTØJ ***
0030 REPEAT
0040   PRINT "1. Beregn Fakultet (!)"
0050   PRINT "2. Afslut"
0060   INPUT "Vaelg (1-2): ": VALG%
0070   IF VALG% = 1 THEN EXEC BEREGN_FAKULTET
0080 UNTIL VALG% = 2
0090 PRINT "Program afsluttet."
0100 STOP
0110
0120 PROC BEREGN_FAKULTET
0130   INPUT "Indtast et heltal (1-10): ": TAL%
0140   IF TAL% < 1 THEN TAL% := 1
0150   IF TAL% > 10 THEN TAL% := 10
0160   RESULTAT := 1
0170   FOR K := 1 TO TAL% DO
0180     RESULTAT := RESULTAT * K
0190   ENDFOR K
0200   PRINT TAL%; "! = ", RESULTAT
0210   PRINT ""
0220 ENDPROC